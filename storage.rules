rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure 1-to-1 Chat Media Storage
    // Chat IDs are deterministically formatted as {sortedUidA}_{sortedUidB}.
    // Only the two participating users are authorized to read, write, or delete media in their room.
    match /chat_media/{chatId}/{fileName} {
      
      // Allow read access if authenticated and user is one of the two participants
      allow read: if request.auth != null && (
        chatId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_-]+$') ||
        chatId.matches('^[a-zA-Z0-9_-]+_' + request.auth.uid + '$')
      );
      
      // Allow create/write if authenticated, user is a participant, file is an image, and size <= 5MB
      allow write: if request.auth != null && (
        chatId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_-]+$') ||
        chatId.matches('^[a-zA-Z0-9_-]+_' + request.auth.uid + '$')
      ) && (
        request.resource == null || (
          request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
          request.resource.size <= 5 * 1024 * 1024
        )
      );
    }

    // User Profile Pictures / Avatars
    match /profile_pictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && (
        request.resource == null || (
          request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
          request.resource.size <= 5 * 1024 * 1024
        )
      );
    }
  }
}
